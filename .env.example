# Server Configuration
PORT=10000
NODE_ENV=production

# Database Connection
# Connection string for MongoDB (Render Managed DB or MongoDB Atlas)
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/crm?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/real_estate_crm

# Authentication
# Secret key used for signing JWT tokens. Use a 64+ character random string.
JWT_SECRET=replace_with_a_secure_random_string_min_32_chars

# CORS / Client Settings
# Full URL where the client application is hosted
CLIENT_URL=https://real-estate-crm.onrender.com